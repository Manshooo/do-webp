{
	"name": "do-webp",
	"version": "2.0.0",
	"description": "Convert images to WebP via npx do-webp",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/manshooo/do-webp.git"
	},
	"bin": {
		"do-webp": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --project tsconfig.test.json",
		"test": "npm run typecheck && npm run build && node --test \"test/**/*.test.ts\"",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"webp",
		"converter",
		"image",
		"resize",
		"svg",
		"npx"
	],
	"license": "MIT"
}
